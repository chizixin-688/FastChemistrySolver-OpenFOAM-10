FoamFile
{
    format          ascii;
    class           dictionary;
    location        "constant";
    object          chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver          ode;
    method          chemistryModel;
}

chemistry       on;

initialChemicalTimeStep 1e-12;

jacobian        exact;

odeCoeffs
{
    solver          rodas34;
    absTol          1e-12;
    relTol          1e-06;
}

OptRodas34Coeffs
{
    absTol          1e-12;
    relTol          1e-06;
    solver          rodas34;
}

OptRosenbrock34Coeffs
{
    absTol          1e-12;
    relTol          1e-06;
}

OptSeulexCoeffs
{
    absTol          1e-12;
    relTol          1e-06;
}

#include        "reactions"

massFraction    false;


